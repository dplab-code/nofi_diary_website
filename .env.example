NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_DETAILS=
SITE_RELEASE_MODE=preview
COMING_SOON=true
INDEXABLE=false

# Official-site Vercel preview (always noindex):
# COMING_SOON=false
# SITE_RELEASE_MODE=preview
# INDEXABLE=false
# VERCEL_ENV=preview (provided by Vercel)

# Atomic production launch: all three required in the SAME deployment.
# COMING_SOON=false
# SITE_RELEASE_MODE=public
# INDEXABLE=true
# VERCEL_ENV=production (provided by Vercel)
# Invalid production full-site combinations throw a NO-GO error.
